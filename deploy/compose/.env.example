POSTGRES_DB=ai_gateway
POSTGRES_USER=example-db-user
POSTGRES_PASSWORD=change-me-db-password

REDIS_USERNAME=example-cache-user
REDIS_PASSWORD=change-me-cache-password

RABBITMQ_DEFAULT_USER=example-mq-user
RABBITMQ_DEFAULT_PASS=change-me-mq-password
RABBITMQ_DEFAULT_VHOST=ai_gateway

RAG_SERVICE_BASIC_AUTH_USERNAME=example-rag-user
RAG_SERVICE_BASIC_AUTH_PASSWORD=change-me-rag-password

GATEWAY_SERVICE_AUTH_USERNAME=example-console-user
GATEWAY_SERVICE_AUTH_PASSWORD=change-me-console-password
GATEWAY_CONSOLE_SESSION_SECRET=change-me-console-session-secret
GATEWAY_CONSOLE_ADMIN_PASSWORD=change-me-admin-password
GATEWAY_CONSOLE_MEMBER_PASSWORD=change-me-member-password
GATEWAY_CHAT_FAST_MODEL=qwen-flash
GATEWAY_MIMO_PROVIDER_BASE_URL=https://api.xiaomimimo.com/v1
GATEWAY_MIMO_PROVIDER_DISPLAY_NAME=Xiaomi MIMO
GATEWAY_CHAT_REASONING_MODEL=mimo-v2.5-pro
GATEWAY_SMART_ROUTING_CODING_KEYWORDS=写代码,实现,重构,debug,报错,异常,单元测试,架构设计
GATEWAY_SMART_ROUTING_LONG_PROMPT_THRESHOLD=240
GATEWAY_CONTENT_GUARD_ENABLED=false
GATEWAY_CONTENT_GUARD_MODEL=qwen-mt-flash
GATEWAY_CONTENT_GUARD_TIMEOUT_MS=3000

# Token 计价，单位为 微元 / 百万 Token。
# 例如：2000000 = 2.00 元 / M tokens，500000 = 0.50 元 / M tokens。
GATEWAY_MODEL_TOKEN_PRICING_DEFAULT_INPUT_MICROYUAN_PER_MILLION=2000000
GATEWAY_MODEL_TOKEN_PRICING_DEFAULT_OUTPUT_MICROYUAN_PER_MILLION=20000000
GATEWAY_MODEL_TOKEN_PRICING_DEFAULT_CACHED_MICROYUAN_PER_MILLION=500000

# qwen-flash 未显式设置时会跟随 default；如需覆盖再填写。
GATEWAY_MODEL_TOKEN_PRICING_QWEN_FLASH_INPUT_MICROYUAN_PER_MILLION=
GATEWAY_MODEL_TOKEN_PRICING_QWEN_FLASH_OUTPUT_MICROYUAN_PER_MILLION=
GATEWAY_MODEL_TOKEN_PRICING_QWEN_FLASH_CACHED_MICROYUAN_PER_MILLION=

AI_GATEWAY_SECRET_DIR=${HOME}/.ai_gateway_secrets
